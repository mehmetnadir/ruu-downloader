{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "0.0.1",
  "description": "__MSG_extDesc__",
  "default_locale": "en",
  "minimum_chrome_version": "116",
  "permissions": [
    "downloads",
    "downloads.ui",
    "downloads.open",
    "storage",
    "unlimitedStorage",
    "sidePanel",
    "offscreen",
    "notifications",
    "power",
    "scripting",
    "alarms"
  ],
  "host_permissions": [
    "*://*/*"
  ],
  "background": {
    "service_worker": "sw.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Ruu Downloader",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://mail.google.com/*",
        "https://outlook.live.com/*",
        "https://outlook.office.com/*",
        "https://outlook.office365.com/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "mail.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "optional_permissions": [
    "nativeMessaging"
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
